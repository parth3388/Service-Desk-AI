# ===========================
# AI Service Desk
# Environment Configuration
# ===========================

APP_NAME=AI Service Desk
APP_VERSION=1.0.0
DEBUG=False

# Database
DATABASE_URL=postgresql://postgres:your_password@postgres:5432/aiservicedesk

# JWT
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq API
GROQ_API_KEY=your_groq_api_key_here
# Model used for call analysis and AutoQA scoring (optional, default shown).
# Groq periodically retires models (e.g. llama-3.3-70b-versatile was retired
# for this tier) — if generation starts failing with a 404 model_not_found
# error, check https://console.groq.com/docs/models for a current model and
# set it here rather than editing code.
# GROQ_MODEL=openai/gpt-oss-120b

# Email (SMTP) — REQUIRED: the app refuses to start without SMTP_USERNAME / SMTP_APP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address_here
SMTP_APP_PASSWORD=your_gmail_app_password_here
FROM_NAME=AI Service Desk
# Seconds before an unreachable SMTP server is given up on
SMTP_TIMEOUT=15

# URLs used inside emails
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Uploads / pipeline (optional, defaults shown)
MAX_UPLOAD_MB=100
PIPELINE_STALE_MINUTES=30
# Background worker threads that run the AI pipeline (see services/job_runner.py).
# Transcription itself is serialized by a lock regardless of this value.
PIPELINE_WORKERS=2

# Report email delivery recovery (see services/email_delivery.py)
# EMAIL_MAX_ATTEMPTS=3
# EMAIL_STALE_MINUTES=15
# EMAIL_RECOVERY_ON_STARTUP=true

# Rate limits for unauthenticated endpoints, "<max requests>/<window seconds>" per IP (optional, defaults shown)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=10/60
# RATE_LIMIT_REGISTER=10/600
# RATE_LIMIT_FORGOT_PASSWORD=5/600
# RATE_LIMIT_RESEND_VERIFICATION=5/600
# RATE_LIMIT_CONTACT=5/600

# For running the backend directly on your machine (not in Docker) use, e.g.:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/aiservicedesk

